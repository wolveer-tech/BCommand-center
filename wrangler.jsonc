{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bcommand-center",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "TRANSFER_FILES", "bucket_name": "command-centre-transfers" }],
  "vars": {
    "TRANSFER_R2_BUCKET": "command-centre-transfers",
    "LIVE_PROVIDER_2_MODE": "dynamic",
    "LIVE_PROVIDER_2_BASE_URL": "https://timst.cfd",
    "LIVE_PROVIDER_2_DYNAMIC_PATH": "/api/live-upcoming",
    "LIVE_PROVIDER_2_DYNAMIC_ROOT": "events",
    "LIVE_PROVIDER_2_ALLOWED_DATA_HOSTS": "timst.cfd",
    "LIVE_PROVIDER_2_ALLOWED_EMBED_HOSTS": "epiembeds.online",
    "MEDIA_FLIXER_BASE_URL": "https://flixer.gd",
    "MEDIA_FLIXER_ALLOWED_HOSTS": "flixer.gd",
    "MEDIA_ATLANTIC_BASE_URL": "https://atlantic.st",
    "MEDIA_ATLANTIC_ALLOWED_HOSTS": "atlantic.st",
    "MEDIA_BOOMFLIX_BASE_URL": "https://boomflix.qzz.io",
    "MEDIA_BOOMFLIX_ALLOWED_HOSTS": "boomflix.qzz.io"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command-centre-push",
      "database_id": "c8104eb8-a695-41d5-896c-0986ec410805"
    }
  ]
}
