{
  "manifest_version": 3,
  "name": "Command Centre StreamCorner Popup Guard",
  "version": "1.1.0",
  "description": "Blocks one observed StreamCorner popunder loader in Chrome.",
  "minimum_chrome_version": "145",
  "permissions": ["declarativeNetRequest"],
  "declarative_net_request": {
    "rule_resources": [
      {"id": "streamcorner_popunder", "enabled": true, "path": "rules.json"}
    ]
  }
}
